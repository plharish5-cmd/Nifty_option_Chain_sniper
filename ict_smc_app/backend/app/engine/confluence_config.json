  "keywords": {
    "_note": "Text is matched case-insensitively, longest phrase first. Each engine emits human-readable verdict strings; this maps them to a normalised verdict. Anything unmatched returns UNKNOWN and is excluded from consensus - it is never guessed.",
    "REVERSAL_UP":    ["reversal up", "bullish reversal", "reversal upside", "short covering", "short-covering", "capitulation low"],
    "REVERSAL_DOWN":  ["reversal down", "bearish reversal", "reversal downside", "long unwinding", "long-unwinding", "blow-off top"],
    "BREAKOUT_UP":    ["breakout up", "bullish breakout", "breakout above", "range expansion up", "bos up"],
    "BREAKOUT_DOWN":  ["breakout down", "bearish breakout", "breakdown", "break down", "range expansion down", "bos down"],
    "CONSOLIDATION":  ["consolidation", "mid-range", "midrange", "range bound", "rangebound", "balanced", "chop", "no trade", "hold / trail", "digestion"],
    "RETRACEMENT":    ["retracement", "pullback", "dip buy", "dip-buy", "throwback"],
    "SUPPORT":        ["support", "floor", "put wall", "demand zone", "put writing"],
    "RESISTANCE":     ["resistance", "cap", "call wall", "supply zone", "call writing"],
    "BULLISH":        ["bullish trinity lock", "bullish_trinity_lock", "bullish confluence", "bullish put control",
                       "bullish_put_control", "aggressive buy dips", "buy dips", "strong bullish", "bullish",
                       "long only", "buy ce", "ce only", "put dominated", "put control", "upside"],
    "BEARISH":        ["bearish trinity lock", "bearish_trinity_lock", "bearish confluence", "bearish call control",
                       "bearish_call_control", "aggressive sell rallies", "sell rallies", "strong bearish", "bearish",
                       "short only", "buy pe", "pe only", "call dominated", "call control", "downside"],
    "NEUTRAL":        ["neutral", "mixed", "forming", "pending", "awaiting", "unavailable", "flat"]
  },

  "verdict_bias": {
    "_note": "Maps a normalised verdict to its directional vote used in consensus arithmetic.",
    "BULLISH": 1, "REVERSAL_UP": 1, "BREAKOUT_UP": 1, "SUPPORT": 1,
    "BEARISH": -1, "REVERSAL_DOWN": -1, "BREAKOUT_DOWN": -1, "RESISTANCE": -1,
    "CONSOLIDATION": 0, "RETRACEMENT": 0, "NEUTRAL": 0, "UNKNOWN": 0
  }
}
