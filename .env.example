# Copy this file to .env and paste your own token. NEVER commit .env.
# Generate at: web.dhan.co -> Profile -> DhanHQ Trading APIs -> Generate Access Token
# Tokens default to 24-hour validity, so refresh this each morning.
# Also enable "Static IP Setting" on that page so a leaked token is useless
# from anywhere but your own connection.
DHAN_ACCESS_TOKEN=paste_your_token_here
DHAN_CLIENT_ID=your_client_id
