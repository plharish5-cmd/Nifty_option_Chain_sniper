[Unit]
Description=NIFTY chain scanner scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/harish/Documents/Swathi K N/1 Trading/option chain/OC
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle:handle-lid-switch --why="NIFTY chain poller active" "/home/harish/Documents/Swathi K N/1 Trading/option chain/OC/.venv/bin/python" scheduler.py
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
